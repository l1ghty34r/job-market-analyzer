# ============================================================================
# Streamlit Secrets — Template für Cloud Deployment
# ============================================================================
#
# Diese Datei zeigt das Format der secrets.toml für Streamlit Cloud.
# NICHT mit echten Werten committen!
#
# Auf Streamlit Cloud:
#   1. App-Settings öffnen → "Secrets"
#   2. Diesen Inhalt einfügen, mit echten Werten
#   3. "Save" klicken — App startet automatisch neu
#
# Lokal:
#   Stattdessen .env nutzen (siehe .env.example)
# ============================================================================

# ─── Adzuna API ──────────────────────────────────────────────────
# Kostenlos registrieren: https://developer.adzuna.com
ADZUNA_APP_ID = "your_app_id_here"
ADZUNA_APP_KEY = "your_app_key_here"

# ─── PostgreSQL (Neon Cloud) ─────────────────────────────────────
# Empfohlen für Streamlit Cloud, weil das Filesystem ephemeral ist.
USE_POSTGRES = "true"
POSTGRES_HOST = "ep-xxx-xxx.eu-central-1.aws.neon.tech"
POSTGRES_PORT = "5432"
POSTGRES_DB = "jobmarket"
POSTGRES_USER = "your_user"
POSTGRES_PASSWORD = "your_password"
# SSL wird automatisch aktiviert für *.neon.tech-Hosts
