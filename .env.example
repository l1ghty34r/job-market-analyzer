# ============================================================================
# JOB DATA SOURCES
# ============================================================================

# Bundesagentur für Arbeit braucht KEINE eigenen Credentials.
# Der API-Key 'jobboerse-jobsuche' ist öffentlich und im Code hinterlegt.

# Adzuna - https://developer.adzuna.com/signup (kostenlos registrieren)
# Free Tier: 250 Calls/Tag
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here


# ============================================================================
# DATABASE
# ============================================================================

# Standard: false (Dashboard liest aus CSVs - funktioniert ohne DB)
# Bei true: Dashboard liest aus PostgreSQL (siehe load_to_postgres.py)
USE_POSTGRES=false

# Lokale Postgres:
#   POSTGRES_HOST=localhost
# Cloud-Postgres bei Neon (https://neon.tech):
#   POSTGRES_HOST=ep-xxx-xxx.eu-central-1.aws.neon.tech
#   SSL wird automatisch aktiviert für *.neon.tech-Hosts

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobmarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Optional: SSL-Modus erzwingen (für andere Cloud-Provider)
# POSTGRES_SSLMODE=require
